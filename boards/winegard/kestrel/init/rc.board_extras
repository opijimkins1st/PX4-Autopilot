#!/bin/sh
#
# Winegard Kestrel specific board extras init
#------------------------------------------------------------------------------

if ! param compare OSD_ATXXXX_CFG 0
then
	atxxxx start -s
fi

# DShot telemetry is always on UART8
dshot telemetry -d /dev/ttyS6

# QMC5883L magnetometer on I2C1 (internal bus)
qmc5883l start -I
