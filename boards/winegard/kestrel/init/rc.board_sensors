#!/bin/sh
#
# Winegard Kestrel board sensors init
#------------------------------------------------------------------------------
board_adc start

# Winegard Kestrel has an onboard ICM-42605 IMU on SPI2.
icm42605 -R 0 -s start

# bmp581 baro on I2C1
bmp581 start -I

# qmc5883l magnetometer on I2C1
qmc5883l start -I
